      "skills": [
        "./skills/claude-code-hooks",
        "./skills/claude-code-slash-commands",
        "./skills/claude-code-subagents",
        "./skills/claude-code-plugins",
        "./skills/claude-code-mcp",
        "./skills/claude-code-skills"
