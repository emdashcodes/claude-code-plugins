{
  "name": "@emdashcodes/google-calendar",
  "version": "0.1.0",
  "description": "Google Calendar CLI for Claude Code",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "google-calendar": "./skills/google-calendar/scripts/google-calendar"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist skills/google-calendar/scripts/dist",
    "prebuild": "npm run clean",
    "postbuild": "mkdir -p skills/google-calendar/scripts/dist && cp -r dist/* skills/google-calendar/scripts/dist/"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "googleapis": "^144.0.0",
    "open": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "google-calendar",
    "calendar",
    "cli",
    "claude-code"
  ],
  "author": "Em Shreve",
  "license": "MIT"
}
