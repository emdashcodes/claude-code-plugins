{
  "name": "default",
  "description": "Clean, balanced hand-drawn style - perfect for general diagrams and documentation",

  "defaults": {
    "background": "#F8F9FA",
    "fontFamily": "Indie Flower",
    "textColor": "#000000"
  },

  "colorPalette": {
    "primary": "#0288D1",
    "secondary": "#00BCD4",
    "accent": "#4CAF50",
    "tertiary": "#FFA726"
  },

  "extendedColors": {
    "info": "#2196F3",
    "success": "#4CAF50",
    "warning": "#FF9800",
    "error": "#F44336",
    "red": "#E53935",
    "orange": "#FB8C00",
    "yellow": "#FDD835",
    "green": "#43A047",
    "cyan": "#00ACC1",
    "blue": "#1E88E5",
    "purple": "#8E24AA",
    "pink": "#D81B60",
    "gray": "#757575",
    "muted": "#9E9E9E"
  },

  "fonts": {
    "title": "bold 24px 'Indie Flower'",
    "body": "16px 'Indie Flower'",
    "code": "14px 'Indie Flower'"
  },

  "shapeDefaults": {
    "roughness": 0.5,
    "bowing": 0.3,
    "strokeWidth": 2,
    "fillStyle": "solid"
  },

  "typeDefaults": {
    "rectangle": {
      "roughness": 0.5,
      "fillStyle": "solid"
    },
    "line": {
      "roughness": 0.3,
      "strokeWidth": 2
    },
    "circle": {
      "roughness": 0.5
    }
  }
}
