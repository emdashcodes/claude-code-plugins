{
  "name": "witchy",
  "description": "Mystical, botanical aesthetic with cream, black, and gold - moons, moths, and magic",

  "defaults": {
    "background": "#FBF8F3",
    "fontFamily": "Indie Flower",
    "textColor": "#000000"
  },

  "colorPalette": {
    "primary": "#000000",
    "secondary": "#B8996B",
    "accent": "#D4AF78",
    "tertiary": "#8B7355"
  },

  "extendedColors": {
    "info": "#5D4E37",
    "success": "#6B8E23",
    "warning": "#D4A574",
    "error": "#8B4513",
    "red": "#7D2E2E",
    "orange": "#B8763E",
    "yellow": "#D4AF37",
    "green": "#5F7161",
    "cyan": "#6B8E8E",
    "blue": "#4A5E7C",
    "purple": "#6A5B8C",
    "pink": "#B8869B",
    "gray": "#8B8378",
    "muted": "#A89F91"
  },

  "fonts": {
    "title": "bold 28px 'Indie Flower'",
    "body": "18px 'Indie Flower'",
    "accent": "italic 20px 'Indie Flower'"
  },

  "shapeDefaults": {
    "roughness": 0.4,
    "bowing": 0.3,
    "strokeWidth": 2.5,
    "fillStyle": "hachure",
    "fillWeight": 1,
    "hachureGap": 30
  },

  "typeDefaults": {
    "rectangle": {
      "roughness": 0.4,
      "fillStyle": "hachure",
      "fillWeight": 1,
      "hachureGap": 30
    },
    "line": {
      "roughness": 0.4,
      "strokeWidth": 2.5
    },
    "circle": {
      "roughness": 0.7,
      "bowing": 0.5
    }
  }
}
